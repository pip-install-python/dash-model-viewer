# Allowlist, never a denylist. A `recursive-exclude` has to be updated every
# time the repo grows a directory, and the failure is silent: the first release
# after someone adds a folder ships it. See .subdomains/PACKAGING.md.

include LICENSE
include README.md
include CHANGELOG.md

include dash_model_viewer/*.py
include dash_model_viewer/dash_model_viewer.js
include dash_model_viewer/vendor/model-viewer-umd.min.js
include dash_model_viewer/vendor/model-viewer-LICENSE
