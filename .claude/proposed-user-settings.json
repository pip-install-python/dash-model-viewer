{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "WebFetch(domain:2plot.dev)",
      "WebFetch(domain:2plot.ai)",
      "WebFetch(domain:cdn.2plot.ai)",
      "WebFetch(domain:modelviewer.2plot.dev)",
      "WebFetch(domain:boilerplate.2plot.dev)",
      "WebFetch(domain:modelviewer.dev)",
      "WebFetch(domain:platform.claude.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:registry.npmjs.org)",
      "WebFetch(domain:unpkg.com)",
      "WebFetch(domain:pypi.org)",
      "WebFetch(domain:docs.render.com)",

      "Bash(pytest*)",
      "Bash(python -m pytest*)",
      "Bash(python -m flake8*)",
      "Bash(python -m build*)",
      "Bash(python scripts/*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git ls-files*)",
      "Bash(git check-ignore*)",
      "Bash(docker build*)",
      "Bash(docker run*)",
      "Bash(docker logs*)",
      "Bash(docker exec*)",
      "Bash(docker ps*)",
      "Bash(docker images*)",
      "Bash(docker rm*)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(twine upload*)",
      "Bash(python -m twine*)",
      "Bash(gh release*)",
      "Bash(render *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  },

  "sandbox": {
    "network": {
      "allowedDomains": [
        "2plot.dev",
        "2plot.ai",
        "cdn.2plot.ai",
        "modelviewer.2plot.dev",
        "boilerplate.2plot.dev",
        "modelviewer.dev",
        "api.anthropic.com",
        "platform.claude.com",
        "github.com",
        "raw.githubusercontent.com",
        "objects.githubusercontent.com",
        "codeload.github.com",
        "registry.npmjs.org",
        "unpkg.com",
        "cdn.jsdelivr.net",
        "pypi.org",
        "files.pythonhosted.org",
        "api.render.com",
        "registry-1.docker.io",
        "auth.docker.io",
        "production.cloudflare.docker.com"
      ],
      "allowLocalBinding": true
    }
  }
}
